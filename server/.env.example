# ---- WeFix Setu API configuration ----

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS).
# localhost and 127.0.0.1 are different origins; list both for local/Cloud Agent previews.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT — MUST be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# --- Database ---
# Leave DATABASE_URL unset to use the built-in SQLite (great for local dev).
DATABASE_FILE=./data/wefix.sqlite

# Set DATABASE_URL to switch to PostgreSQL (e.g. a free Neon database).
# Example: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/wefix?sslmode=require
# DATABASE_URL=
# Set PGSSL=disable for a local Postgres without TLS (managed providers need SSL).
# PGSSL=disable

# Seed demo data automatically on boot if the database is empty (handy for
# first deploys). Set to false for a clean production database.
# SEED_ON_BOOT=true

# Default platform handling fee (currency units) applied to new orders.
DEFAULT_HANDLING_FEE=5

# Currency for payments (ISO 4217). Default eur.
CURRENCY=eur

# --- Payments (Stripe) ---
# Leave unset to use the built-in mock checkout (demo). Set all three to go live
# with real Stripe payments. Get test keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Create a webhook (events: payment_intent.succeeded) pointing at
# <APP_URL>/api/webhooks/stripe and paste its signing secret here:
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL of the deployed app (used in emails + Stripe receipts).
# APP_URL=https://your-app.example.com

# --- Transactional email (Resend) ---
# Leave unset to log emails to the console (dev). Set to send real email.
# Get a key at https://resend.com
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxx
# EMAIL_FROM=WeFix Setu <noreply@yourdomain.com>
